# =============================================================================
# AppGate Production Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# ── PostgreSQL Database ──────────────────────────────────────────────────────
APPGATE_PG_DSN=postgres://appgate:CHANGE_ME@localhost:5432/appgate?sslmode=disable
APPGATE_PG_HOST=localhost
APPGATE_PG_PORT=5432
APPGATE_PG_DATABASE=appgate
APPGATE_PG_USER=appgate
APPGATE_PG_PASSWORD=CHANGE_ME
APPGATE_PG_SSLMODE=disable
APPGATE_PG_MAX_OPEN_CONNS=25
APPGATE_PG_MAX_IDLE_CONNS=5
APPGATE_PG_CONN_MAX_LIFETIME=5m

# ── Redis ───────────────────────────────────────────────────────────────────
APPGATE_REDIS_URL=redis://localhost:6379/0
APPGATE_REDIS_HOST=localhost
APPGATE_REDIS_PORT=6379
APPGATE_REDIS_DB=0
APPGATE_REDIS_PASSWORD=

# ── JWT Authentication ──────────────────────────────────────────────────────
APPGATE_JWT_SECRET=generate-a-256-bit-random-secret-and-place-here
APPGATE_JWT_ISSUER=appgate
APPGATE_JWT_AUDIENCE=appgate-control-plane
APPGATE_JWT_EXPIRY=24h

# ── Control Plane ───────────────────────────────────────────────────────────
APPGATE_LISTEN_ADDR=:8080
APPGATE_METRICS_ADDR=:9090
APPGATE_GRPC_ADDR=:9091
APPGATE_CONTROL_PLANE_URL=http://appgate-control-plane:8080

# ── Gateway ─────────────────────────────────────────────────────────────────
APPGATE_BIND_ADDR=0.0.0.0
APPGATE_PORT=8080
APPGATE_METRICS_PORT=9090
APPGATE_LOG_LEVEL=info
APPGATE_ENVIRONMENT=production
APPGATE_CORS_ORIGINS=
APPGATE_MAX_BODY_BYTES=10485760
APPGATE_UPSTREAM_DEFAULT_URL=
APPGATE_UPSTREAM_CONNECT_TIMEOUT_MS=5000
APPGATE_UPSTREAM_READ_TIMEOUT_MS=60000
APPGATE_UPSTREAM_KEEPALIVE_SECS=30
APPGATE_UPSTREAM_MAX_CONNECTIONS=1000
APPGATE_RATE_LIMIT_ENABLED=true
APPGATE_RATE_LIMIT_RPS=100
APPGATE_RATE_LIMIT_BURST=150
APPGATE_RATE_LIMIT_WINDOW_SECS=60
APPGATE_CACHE_ENABLED=true
APPGATE_CACHE_TTL_SECS=60
APPGATE_CACHE_MAX_SIZE=10000
APPGATE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
APPGATE_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_MS=30000
APPGATE_CIRCUIT_BREAKER_HALF_OPEN_MAX_CALLS=3
APPGATE_JWT_ENABLED=true
APPGATE_JWT_KEY_PATH=
APPGATE_JWT_JWKS_URL=
APPGATE_APPROVED_DOMAINS=api.openai.com,api.anthropic.com
APPGATE_APPROVED_IPS=
APPGATE_ROUTES=

# ── TLS ─────────────────────────────────────────────────────────────────────
APPGATE_TLS_ENABLED=false
APPGATE_TLS_CERT_PATH=
APPGATE_TLS_KEY_PATH=
APPGATE_TLS_MIN_VERSION=1.2

# ── Observability ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
APPGATE_OTLP_ENDPOINT=http://localhost:4317
APPGATE_OTEL_SERVICE_NAME=appgate-gateway