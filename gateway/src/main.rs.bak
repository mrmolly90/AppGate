use clap::Parser;
use std::net::SocketAddr;
use tracing::info;

mod server;
mod tls;
mod jwt;
mod policy;
mod rate_limit;
mod metrics;
mod audit;
mod ssrf;
mod proxy;
mod router;
mod telemetry;

#[derive(Parser, Debug, Clone)]
#[command(name = "appgate-gateway", version, about)]
pub struct Args {
    #[arg(long, default_value = "0.0.0.0:8443")]
    pub listen: SocketAddr,
    #[arg(long, default_value = "")]
    pub tls_cert_path: String,
    #[arg(long, default_value = "")]
    pub tls_key_path: String,
    #[arg(long, default_value = "")]
    pub jwt_key_path: String,
    #[arg(long, default_value = "")]
    pub control_plane_url: String,
    #[arg(long, default_value = "info")]
    pub log_level: String,
    #[arg(long, default_value = "")]
    pub otlp_endpoint: String,
    #[arg(long, default_value = "")]
    pub redis_url: String,
    #[arg(long, default_value = "/tmp/appgate/audit")]
    pub audit_queue_path: String,
    #[arg(long, default_value_t = 100)]
    pub audit_batch_size: usize,
    #[arg(long, default_value_t = 1000)]
    pub audit_flush_interval_ms: u64,
    #[arg(long, default_value_t = 100)]
    pub upstream_pool_size: usize,
    #[arg(long, default_value_t = 30)]
    pub upstream_timeout_secs: u64,
    #[arg(long, default_value_t = false)]
    pub health_check: bool,
    #[arg(long, value_delimiter = ',', default_value = "")]
    pub approved_providers: Vec<String>,
}

#[tokio::main]
async fn main() -> anyhow::Result<()> {
    let args = Args::parse();
    
    if args.health_check {
        println!("ok");
        return Ok(());
    }

    info!("AppGate Gateway v{} starting on {}", env!("CARGO_PKG_VERSION"), args.listen);
    
    if !args.otlp_endpoint.is_empty() {
        telemetry::init_telemetry(&args.otlp_endpoint)?;
    }
    
    server::run_server(args.listen, &args).await?;
    Ok(())
}